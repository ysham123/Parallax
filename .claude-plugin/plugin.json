  "keywords": ["coding-agents", "code-review", "multi-model", "codex", "grok", "antigravity", "verification"],
  "mcpServers": {
    "parallax": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/launch.sh",
